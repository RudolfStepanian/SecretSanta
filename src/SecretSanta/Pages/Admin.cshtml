@page "/admin/{token}"
@model AdminModel
@{
    ViewData["Title"] = T["AdminTitle"];
    ViewData["Home"] = $"/admin/{Model.Game.AdminToken}";
    var drawn = Model.Game.DrawnAt is not null;
}

<h1>@T["AdminTitle"]</h1>
<partial name="_GameInfo" model="Model.Game" />

@if (Model.Created)
{
    <div class="alert warn">@T["AdminSaveLink"]</div>
}
@if (Model.ErrorKey is not null)
{
    <div class="alert err">@T[Model.ErrorKey]</div>
}
@if (Model.ResetUrl is not null)
{
    <div class="alert ok">
        <p>@T.F("ResetIssued", Model.ResetName ?? "")</p>
        <partial name="_Copy" model="Model.ResetUrl" />
    </div>
}

<section class="card">
    <h2>@T["InviteLink"]</h2>
    <p class="hint">@T["InviteHint"]</p>
    <partial name="_Copy" model="@Request.Abs($"/join/{Model.Game.InviteToken}")" />
</section>

<form method="post" asp-page-handler="Info" class="card" id="info">
    <h2>@T["GameInfoTitle"]</h2>
    <p class="hint">@T["GameInfoHint"]</p>
    @if (Model.InfoSaved)
    {
        <div class="alert ok">@T["Saved"]</div>
    }

    <label for="budget">@T["Budget"]</label>
    <input id="budget" name="budget" type="text" maxlength="@Limits.Budget" value="@Model.Game.Budget" />

    <label for="note">@T["Note"]</label>
    <textarea id="note" name="note" maxlength="@Limits.Note" placeholder="@T["NotePlaceholder"]">@Model.Game.Note</textarea>

    <div class="actions">
        <button type="submit" class="btn green">@T["Save"]</button>
    </div>
</form>

<section class="card">
    <h2>@T["Draw"]</h2>
    @if (drawn)
    {
        <p>@T.F("DrawDone", Fmt.Local(Model.Game.DrawnAt!.Value))</p>
        <p>@T.F("CardsOpened", Model.People.Count(p => p.RevealedAt is not null), Model.People.Count)</p>
        <p>@T.F("GiftsReady", Model.People.Count(p => p.GiftReadyAt is not null), Model.People.Count)</p>
        <p class="muted">@T["OrganizerBlind"]</p>
        <form method="post" asp-page-handler="Undraw" data-confirm="@T["UndrawConfirm"]" class="actions">
            <button type="submit" class="btn secondary">@T["Undraw"]</button>
        </form>
    }
    else
    {
        <p class="muted">@T["OrganizerBlind"]</p>
        <form method="post" asp-page-handler="Draw" data-confirm="@T["DrawConfirm"]" class="actions">
            <button type="submit" class="btn" disabled="@(Model.People.Count < Draw.MinParticipants)">@T["Draw"]</button>
        </form>
        @if (Model.People.Count < Draw.MinParticipants)
        {
            <p class="hint">@T["DrawNeedMore"]</p>
        }
    }
</section>

<section class="card">
    <h2>@T["Participants"] <span class="count">@Model.People.Count</span></h2>
    @if (!drawn && Model.Waiting.Count > 0)
    {
        <p class="hint">@T.F("SignupsWaiting", string.Join(", ", Model.Waiting))</p>
    }
    @if (Model.People.Count == 0)
    {
        <p class="muted">@T["NoParticipants"]</p>
    }
    else
    {
        <ul class="people">
            @foreach (var p in Model.People)
            {
                <li>
                    <div class="who">
                        <div class="name">@p.Name</div>
                        <div class="hint">
                            @if (p.Login is null)
                            {
                                <text>@T["NoLogin"] · </text>
                            }
                            else if (!p.Login.Contains('@'))
                            {
                                @* A login that is an e-mail address stays hidden: only the participant sees their address. *@
                                <text>@T.F("LoginIs", p.Login) · </text>
                            }
                            @(p.Wishlist is null ? T["WishlistEmpty"] : T["WishlistFilled"])
                            @if (p.PasswordHash is null)
                            {
                                <text> · @T["NoPassword"]</text>
                            }
                            @if (Model.MailEnabled && p.Email is null)
                            {
                                <text> · @T["NoMail"]</text>
                            }
                            @if (drawn)
                            {
                                <text> · @(p.RevealedAt is null ? T["CardNotOpened"] : T["CardOpened"])</text>
                                <text> · @(p.GiftReadyAt is null ? T["GiftNotReadyMark"] : T["GiftReadyMark"])</text>
                            }
                        </div>
                    </div>
                    <div class="row-actions">
                        <form method="post" asp-page-handler="Reset" asp-route-id="@p.Id" data-confirm="@T.F("ResetConfirm", p.Name)">
                            <button type="submit" class="btn small secondary">@T["ResetPassword"]</button>
                        </form>
                        @if (!drawn)
                        {
                            <form method="post" asp-page-handler="Remove" asp-route-id="@p.Id" data-confirm="@T.F("RemoveConfirm", p.Name)">
                                <button type="submit" class="btn small secondary danger">@T["Remove"]</button>
                            </form>
                        }
                    </div>
                </li>
            }
        </ul>
    }
</section>

<section class="card">
    <h2>@T["Exclusions"]</h2>
    <p class="hint">@T["ExclusionsHint"]</p>
    @if (Model.Pairs.Count == 0)
    {
        <p class="muted">@T["NoExclusions"]</p>
    }
    else
    {
        <ul class="people">
            @foreach (var x in Model.Pairs)
            {
                <li>
                    <div class="name">@x.A ⇄ @x.B</div>
                    @if (!drawn)
                    {
                        <form method="post" asp-page-handler="Unexclude" asp-route-id="@x.Id">
                            <button type="submit" class="btn small secondary danger">@T["Remove"]</button>
                        </form>
                    }
                </li>
            }
        </ul>
    }
    @if (!drawn)
    {
        @if (Model.People.Count < 2)
        {
            <p class="hint">@T["ExclusionsNeedTwo"]</p>
        }
        else
        {
            <form method="post" asp-page-handler="Exclude" class="row">
                <select name="a" aria-label="1">
                    @foreach (var p in Model.People)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </select>
                <select name="b" aria-label="2">
                    @foreach (var (p, i) in Model.People.Select((p, i) => (p, i)))
                    {
                        <option value="@p.Id" selected="@(i == 1)">@p.Name</option>
                    }
                </select>
                <button type="submit" class="btn small green">@T["AddExclusion"]</button>
            </form>
        }
    }
</section>

<section class="card" id="delete">
    <h2>@T["DeleteTitle"]</h2>
    <p class="hint">@T.F("AutoDeleteOn", Fmt.Local(GameCleanup.DeleteAt(Model.Game)), GameCleanup.DaysAfterDraw, GameCleanup.DaysWithoutDraw)</p>
    <form method="post" asp-page-handler="Delete" data-confirm="@T["DeleteConfirm"]" class="actions">
        <button type="submit" class="btn small secondary danger">@T["DeleteGame"]</button>
    </form>
</section>
