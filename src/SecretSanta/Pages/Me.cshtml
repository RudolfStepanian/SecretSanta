@page "/play/{invite}"
@model MeModel
@{
    ViewData["Title"] = Model.Me.Name;
    var game = Model.Me.Game;
    var recipient = game.DrawnAt is not null ? Model.Me.Recipient : null;
    var santaLabel = T["WhoSanta"];
}

<h1>@T.F("Hello", Model.Me.Name)</h1>
<partial name="_GameInfo" model="game" />
@if (Model.Me.ResetCount > 0 && Model.Me.ResetAt is { } resetAt)
{
    <p class="muted">@T.F("ResetHistory", Model.Me.ResetCount, Fmt.Local(resetAt))</p>
}

@if (Model.IsNew)
{
    <div class="alert ok">@T["Welcome"]</div>
}
@if (Model.PasswordSaved)
{
    <div class="alert ok">@T["PasswordSet"]</div>
}
@if (Model.Me.Login is null || Model.Me.PasswordHash is null)
{
    <form method="post" asp-page-handler="Credentials" class="card">
        <h2>@T["CredentialsTitle"]</h2>
        <p class="hint">@(Model.Me.PasswordHash is null ? T["SetPasswordHint"] : T["SetLoginHint"])</p>

        @if (Model.Me.Login is null)
        {
            <label for="login">@T["Login"]</label>
            <p class="hint">@T["LoginHint"]</p>
            <input id="login" name="Login" type="text" required minlength="@Limits.LoginMin" maxlength="@Limits.Login" value="@Model.Login" autocomplete="username" autocapitalize="none" spellcheck="false" />
            @if (Model.LoginErrorKey is not null)
            {
                <p class="field-error">@T[Model.LoginErrorKey]</p>
            }
        }
        else
        {
            <input type="text" name="Login" value="@Model.Me.Login" autocomplete="username" hidden />
        }

        @if (Model.Me.PasswordHash is null)
        {
            <label for="password">@T["Password"]</label>
            <p class="hint">@T["PasswordHint"]</p>
            <input id="password" name="Password" type="password" required minlength="@Limits.PasswordMin" maxlength="@Limits.Password" autocomplete="new-password" />

            <label for="password-repeat">@T["PasswordRepeat"]</label>
            <input id="password-repeat" name="PasswordRepeat" type="password" required minlength="@Limits.PasswordMin" maxlength="@Limits.Password" autocomplete="new-password" />
            @if (Model.PasswordErrorKey is not null)
            {
                <p class="field-error">@T[Model.PasswordErrorKey]</p>
            }
        }

        <div class="actions">
            <button type="submit" class="btn green">@T["Save"]</button>
        </div>
    </form>
}

@if (Model.SantaThread.LastOrDefault() is { FromSanta: true })
{
    <div class="alert ok">@T["SantaWrote"] <a href="#santa">@T["ReadIt"]</a></div>
}
@if (Model.Me.RevealedAt is not null && Model.AskThread.LastOrDefault() is { FromSanta: false })
{
    <div class="alert ok">@T["RecipientReplied"] <a href="#ask">@T["ReadIt"]</a></div>
}

@if (recipient is null)
{
    <section class="card waiting">
        <p>@T["NotDrawnYet"]</p>
    </section>
}
else
{
    var revealed = Model.Me.RevealedAt is not null;
    @if (!revealed)
    {
        <section class="card">
            <h2>@T["PickTitle"]</h2>
            <p class="hint">@T["PickHint"]</p>
            <form method="post" asp-page-handler="Reveal" class="deck">
                @for (var i = 1; i < game.Participants.Count; i++)
                {
                    var design = i % 2 == 1 ? "cane" : "gingerbread";
                    <button type="submit" class="playcard" aria-label="@T.F("CardLabel", i)">
                        <span class="inner">
                            <span class="back" aria-hidden="true"><span class="emblem"><svg viewBox="0 0 60 60"><use href="/img/candy.svg#@design" /></svg></span></span>
                            <span class="face"></span>
                        </span>
                    </button>
                }
            </form>
        </section>
        <div class="result" id="reveal-result" hidden></div>
    }
    else
    {
        <div class="result" id="reveal-result">
            <partial name="_Reveal" model="Model" />
        </div>
    }

    <section class="card" id="santa">
        <h2>@T["SantaTitle"]</h2>
        <p class="hint">@T["SantaHint"]</p>
        <partial name="_Thread" model="new ThreadView(Model.SantaThread, false, santaLabel)" />
        <form method="post" asp-page-handler="Answer" class="send">
            <textarea name="Text" required maxlength="@Limits.Message" class="short" placeholder="@T["AnswerPlaceholder"]" aria-label="@T["SantaTitle"]"></textarea>
            <button type="submit" class="btn green">@T["Send"]</button>
        </form>
    </section>
}

@if (Model.MailEnabled)
{
    <form method="post" asp-page-handler="Mail" class="card" id="mail">
        <h2>@T["MailTitle"]</h2>
        <p class="hint">@T["MailHint"]</p>
        @if (Model.Me.Email is not null)
        {
            <p>@T.F("MailLinked", Model.Me.Email)</p>
        }
        @if (Model.MailPending)
        {
            <div class="alert ok">@T.F("MailPending", Model.Me.PendingEmail!)</div>
        }

        <label for="email">@T["MailAddress"]</label>
        <input id="email" name="Email" type="email" required maxlength="@Limits.Email" value="@Model.Email" autocomplete="email" autocapitalize="none" spellcheck="false" />
        @if (Model.MailErrorKey is not null)
        {
            <p class="field-error">@T[Model.MailErrorKey]</p>
        }

        <div class="actions">
            <button type="submit" class="btn green">@T["MailSend"]</button>
            @if (Model.Me.Email is not null && Model.Me.Login != Model.Me.Email)
            {
                <button type="submit" class="btn small secondary" asp-page-handler="MailRemove" formnovalidate>@T["MailRemove"]</button>
            }
        </div>
    </form>
}

<form method="post" class="card">
    <h2>@T["MyWishlist"]</h2>
    <p class="hint">@T["MyWishlistHint"]</p>
    @if (Model.IsSaved)
    {
        <div class="alert ok">@T["Saved"]</div>
    }

    <label for="name">@T["YourName"]</label>
    <input id="name" name="Name" type="text" required maxlength="@Limits.PersonName" value="@Model.Name" autocomplete="name" />
    @if (Model.ErrorKey is not null)
    {
        <p class="field-error">@T[Model.ErrorKey]</p>
    }

    <label for="wishlist">@T["Wishlist"]</label>
    <p class="hint">@T["WishlistHint"]</p>
    <textarea id="wishlist" name="Wishlist" maxlength="@Limits.Wishlist">@Model.Wishlist</textarea>

    <label for="notwanted">@T["NotWanted"]</label>
    <p class="hint">@T["NotWantedHint"]</p>
    <textarea id="notwanted" name="NotWanted" maxlength="@Limits.NotWanted" class="short">@Model.NotWanted</textarea>

    <div class="actions">
        <button type="submit" class="btn green">@T["Save"]</button>
    </div>
</form>

<form method="post" asp-page-handler="Logout" class="actions signed-in">
    @if (Model.Me.Login is not null)
    {
        <span>@T.F("YourLogin", Model.Me.Login)</span>
    }
    <button type="submit" class="btn small secondary">@T["Logout"]</button>
</form>
