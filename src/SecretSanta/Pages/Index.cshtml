@page "/"
@model IndexModel
@{
    ViewData["Title"] = T["NewGame"];
}

<section class="hero">
    <h1>Secret <span>Santa</span></h1>
    <p>@T["Tagline"]</p>
</section>

@if (Model.Deleted)
{
    <div class="alert ok">@T["GameDeleted"]</div>
}

<section class="card">
    <h2>@T["HowItWorks"]</h2>
    <ol class="steps">
        <li>@T["Step1"]</li>
        <li>@T["Step2"]</li>
        <li>@T["Step3"]</li>
    </ol>
</section>

<form method="post" class="card">
    <h2>@T["NewGame"]</h2>

    <label for="budget">@T["Budget"]</label>
    <input id="budget" name="Budget" type="text" maxlength="@Limits.Budget" value="@Model.Budget" placeholder="10 000 ֏" />

    <label for="note">@T["Note"]</label>
    <textarea id="note" name="Note" maxlength="@Limits.Note" placeholder="@T["NotePlaceholder"]">@Model.Note</textarea>

    <div class="actions">
        <button type="submit" class="btn">@T["Create"]</button>
    </div>
</form>
