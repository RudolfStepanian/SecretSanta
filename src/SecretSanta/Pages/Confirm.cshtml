@page "/mail/{token}"
@model ConfirmModel
@{
    ViewData["Title"] = T["MailConfirmTitle"];
}

<section class="card waiting">
    <h1>@T["MailConfirmTitle"]</h1>
    @if (Model.Done)
    {
        <p>@T.F("MailConfirmed", Model.Address)</p>
        <a class="btn green" href="/play/@Model.Invite">@T["OpenMyPage"]</a>
    }
    else if (Model.Taken)
    {
        <p class="muted">@T["MailUsed"]</p>
        <a class="btn secondary" href="/play/@Model.Invite">@T["OpenMyPage"]</a>
    }
    else if (Model.Expired)
    {
        <p class="muted">@T["MailLinkExpired"]</p>
        <a class="btn secondary" href="/play/@Model.Invite">@T["OpenMyPage"]</a>
    }
    else
    {
        <p>@T.F("MailConfirmText", Model.Address, Model.Name)</p>
        <form method="post">
            <button type="submit" class="btn green">@T["MailConfirmButton"]</button>
        </form>
    }
</section>
