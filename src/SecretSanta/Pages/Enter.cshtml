@page "/me/{token}"
@model EnterModel
@{
    var title = Model.UsedAt is not null ? T["ResetUsedTitle"] : Model.Expired ? T["ResetExpiredTitle"] : T["ResetEnterTitle"];
    ViewData["Title"] = title;
    var home = $"/play/{Model.Invite}";
    ViewData["Home"] = home;
}

<section class="card waiting">
    <h1>@title</h1>
    @if (Model.UsedAt is { } usedAt)
    {
        <p class="muted">@T.F("ResetUsedText", Fmt.Local(usedAt))</p>
        <a class="btn secondary" href="@home">@T["BackHome"]</a>
    }
    else if (Model.Expired)
    {
        <p class="muted">@T["ResetExpiredText"]</p>
        <a class="btn secondary" href="@home">@T["BackHome"]</a>
    }
    else
    {
        <p class="muted">@T["ResetEnterText"]</p>
        <form method="post">
            <button type="submit" class="btn green">@T["ResetEnterButton"]</button>
        </form>
    }
</section>
