@page "/not-found/{code:int?}"
@attribute [IgnoreAntiforgeryToken]
@{
    // Status code pages land here (Program.cs). A form post over the rate limits is re-executed here as a post too.
    var tooMany = ViewContext.RouteData.Values["code"] as string == "429";
    ViewData["Title"] = tooMany ? T["TooManyTitle"] : T["NotFoundTitle"];
}

<section class="card waiting">
    <h1>@(tooMany ? T["TooManyTitle"] : T["NotFoundTitle"])</h1>
    <p class="muted">@(tooMany ? T["TooManyText"] : T["NotFoundText"])</p>
    <a class="btn secondary" href="/">@T["BackHome"]</a>
</section>
