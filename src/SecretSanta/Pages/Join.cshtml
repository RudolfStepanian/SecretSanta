@page "/join/{token}"
@model JoinModel
@{
    ViewData["Title"] = T["AuthTitle"];
    var drawn = Model.Game.DrawnAt is not null;
    var signInUrl = $"/join/{Model.Game.InviteToken}";
    var registerUrl = $"/join/{Model.Game.InviteToken}?mode=register";
}

<h1>@T["AuthTitle"]</h1>
<partial name="_GameInfo" model="Model.Game" />
<p class="muted">@T.F("JoinedCount", Model.Game.Participants.Count)</p>

@if (Model.Existing is not null)
{
    <div class="alert ok">
        <p>@T.F("AlreadyJoined", Model.Existing.Name)</p>
        <a class="btn small green" href="/play/@Model.Game.InviteToken">@T["OpenMyPage"]</a>
    </div>
}

<section class="card">
    @if (!drawn)
    {
        <nav class="tabs">
            <a href="@signInUrl" class="@(Model.Registering ? null : "on")" aria-current="@(Model.Registering ? null : "page")">@T["TabSignIn"]</a>
            <a href="@registerUrl" class="@(Model.Registering ? "on" : null)" aria-current="@(Model.Registering ? "page" : null)">@T["TabRegister"]</a>
        </nav>
    }

    @if (Model.Registering)
    {
        <form method="post">
            @if (Model.SignupSentTo is not null)
            {
                <div class="alert ok">@T.F("SignupSent", Model.SignupSentTo)</div>
            }
            @if (Model.Full)
            {
                <div class="alert err">@T.F("GameFull", Limits.MaxParticipants)</div>
            }
            <label for="email">@T["MailAddress"]</label>
            <p class="hint">@(Model.MailEnabled ? T["SignupEmailHint"] : T["EmailLoginHint"])</p>
            <input id="email" name="Email" type="email" required maxlength="@Limits.Email" value="@Model.Email" autocomplete="username" autocapitalize="none" spellcheck="false" />
            @if (Model.EmailErrorKey is not null)
            {
                <p class="field-error">@T[Model.EmailErrorKey]</p>
            }

            <label for="password">@T["Password"]</label>
            <p class="hint">@T["PasswordHint"]</p>
            <input id="password" name="Password" type="password" required minlength="@Limits.PasswordMin" maxlength="@Limits.Password" autocomplete="new-password" />

            <label for="password-repeat">@T["PasswordRepeat"]</label>
            <input id="password-repeat" name="PasswordRepeat" type="password" required minlength="@Limits.PasswordMin" maxlength="@Limits.Password" autocomplete="new-password" />
            @if (Model.PasswordErrorKey is not null)
            {
                <p class="field-error">@T[Model.PasswordErrorKey]</p>
            }

            <label for="name">@T["YourName"]</label>
            <p class="hint">@T["YourNameHint"]</p>
            <input id="name" name="Name" type="text" required maxlength="@Limits.PersonName" value="@Model.Name" autocomplete="name" />
            @if (Model.NameErrorKey is not null)
            {
                <p class="field-error">@T[Model.NameErrorKey]</p>
            }

            <label for="wishlist">@T["Wishlist"]</label>
            <p class="hint">@T["WishlistHint"]</p>
            <textarea id="wishlist" name="Wishlist" maxlength="@Limits.Wishlist">@Model.Wishlist</textarea>

            <label for="notwanted">@T["NotWanted"]</label>
            <p class="hint">@T["NotWantedHint"]</p>
            <textarea id="notwanted" name="NotWanted" maxlength="@Limits.NotWanted" class="short">@Model.NotWanted</textarea>

            <div class="actions">
                <button type="submit" class="btn">@T["JoinButton"]</button>
            </div>
        </form>
    }
    else
    {
        <form method="post" asp-page-handler="SignIn">
            <label for="signin-login">@T["SignInId"]</label>
            <input id="signin-login" name="SignInLogin" type="text" required maxlength="@Limits.Email" value="@Model.SignInLogin" autocomplete="username" autocapitalize="none" spellcheck="false" />

            <label for="signin-password">@T["Password"]</label>
            <input id="signin-password" name="SignInPassword" type="password" required maxlength="@Limits.Password" autocomplete="current-password" />
            @if (Model.SignInErrorKey is not null)
            {
                <p class="field-error">@T[Model.SignInErrorKey]</p>
            }

            <div class="actions">
                <button type="submit" class="btn green">@T["LoginButton"]</button>
            </div>
        </form>
        @if (drawn)
        {
            <p class="hint">@T["JoinClosed"]</p>
        }
        @if (Model.MailEnabled)
        {
            <details class="forgot" id="forgot" open="@Model.ForgotSent">
                <summary>@T["ForgotTitle"]</summary>
                @if (Model.ForgotSent)
                {
                    <div class="alert ok">@T["ForgotSent"]</div>
                }
                else
                {
                    <p class="hint">@T["ForgotHint"]</p>
                }
                <form method="post" asp-page-handler="Forgot">
                    <label for="forgot-login">@T["SignInId"]</label>
                    <input id="forgot-login" name="ForgotLogin" type="text" required maxlength="@Limits.Email" autocomplete="username" autocapitalize="none" spellcheck="false" />
                    <div class="actions">
                        <button type="submit" class="btn small secondary">@T["ForgotButton"]</button>
                    </div>
                </form>
            </details>
        }
    }
</section>
